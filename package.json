{
  "name": "3d-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:tangents": "node scripts/prepare-tangents.mjs",
    "prepare:anatomy": "python3 scripts/prepare-anatomy.py",
    "predev": "npm run prepare:tangents && npm run prepare:anatomy",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run prepare:tangents && npm run prepare:anatomy",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/server.mjs",
    "pretest": "npm run prepare:tangents && npm run prepare:anatomy",
    "test": "node --test tests/*.test.js",
    "bake": "node scripts/bake.mjs",
    "review:reference": "node scripts/review-reference.mjs",
    "check": "npm test && npm run build && npm run bake",
    "render": "node scripts/render.mjs",
    "doctor": "node scripts/render.mjs --doctor",
    "test:render": "node scripts/check-local-render.mjs",
    "study": "node scripts/study.mjs",
    "measure:sculpt": "node scripts/measure-sculpt.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright-core": "1.58.2"
  }
}
